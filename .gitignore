# Local environments and editor state
/.venv/
/.idea/
/.vscode/

# macOS metadata
.DS_Store
._*

# Python bytecode, build output, and package metadata
__pycache__/
*.py[cod]
*$py.class
/build/
/dist/
*.egg-info/

