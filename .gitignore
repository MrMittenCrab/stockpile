# Local environments and editor state
/.venv/
/.idea/
/.vscode/

# macOS metadata
.DS_Store
._*

# Python bytecode, build output, and package metadata
__pycache__/
*.py[cod]
*$py.class
/build/
/dist/
*.egg-info/

# Test, type-checking, lint, and coverage caches
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.hypothesis/
/.tox/
/.nox/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/

# Frontend dependencies, builds, and browser-test output
/stockpile/frontend/node_modules/
/stockpile/frontend/dist/
/stockpile/frontend/coverage/
/stockpile/frontend/playwright-report/
/stockpile/frontend/test-results/

# Local environment variables and secrets
/.env
/.env.*
!/.env.example
!/.env.template
/.secrets/
*.pem
*.key

# Generated Deep CFR runs and model checkpoints
/stockpile/artifacts/**
!/stockpile/artifacts/deep_cfr/
!/stockpile/artifacts/deep_cfr/lite/
!/stockpile/artifacts/deep_cfr/lite/run_03/
!/stockpile/artifacts/deep_cfr/lite/run_03/run.json
!/stockpile/artifacts/deep_cfr/lite/run_03/round_01/
!/stockpile/artifacts/deep_cfr/lite/run_03/round_01/policy.pt
/artifacts/
/checkpoints/
/runs/
/wandb/
*.pt
*.pth
*.ckpt
!/stockpile/artifacts/deep_cfr/lite/run_03/round_01/policy.pt

# Write-up notebook, figures, and capture tooling (local only)
/stockpile/writeup/
